# Road Designer V 1.0 — gitignore

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtualenvs
Road_venv/
.venv/
venv/

# Local outputs (DXF, Excel, CSV, PDF) — never commit generated artifacts
output/
*.dxf
*.xlsx
*.csv
*.pdf
# Exceptions: anything under samples/ ships with the app
!samples/**

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# Excel lock / temp files
~$*
\#*

# Streamlit
.streamlit/secrets.toml
